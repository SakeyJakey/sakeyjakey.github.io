---
import { siteConfig } from "../data/site";
import { servicesData } from "../data/services";
import { Mail, ArrowUp } from "@lucide/astro";
import SocialIcons from "./icons/SocialIcons.astro";
---

<footer class="bg-slate-950 text-slate-400 border-t border-slate-800/80 mt-auto">
  <!-- Main Footer Section -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-8">
      
      <!-- Brand & Tagline -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-3">
          <img src="/img/logo.png" alt="Kulexar Logo" class="h-10 w-auto object-contain" />
          <span class="text-2xl font-bold text-white tracking-tight">{siteConfig.name}</span>
        </a>
        <p class="text-slate-300 text-sm font-medium">
          {siteConfig.tagline}
        </p>
        <p class="text-slate-400 text-sm max-w-sm leading-relaxed">
          Specialising in Fire Safety, QSHE Compliance Management, and Sustainability & Net Zero.
        </p>
        <!-- Social Icons -->
        <div class="flex items-center gap-3 pt-2">
          <a
            href={siteConfig.socials.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="w-10 h-10 rounded-full bg-slate-900 border border-slate-800 flex items-center justify-center text-slate-300 hover:text-[#69a5bf] hover:border-[#69a5bf]/50 hover:bg-slate-800 transition-all"
          >
            <SocialIcons name="linkedin" class="w-4 h-4" />
          </a>
          <a
            href={siteConfig.socials.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="w-10 h-10 rounded-full bg-slate-900 border border-slate-800 flex items-center justify-center text-slate-300 hover:text-[#69a5bf] hover:border-[#69a5bf]/50 hover:bg-slate-800 transition-all"
          >
            <SocialIcons name="instagram" class="w-4 h-4" />
          </a>
          <a
            href={siteConfig.socials.email}
            aria-label="Email Us"
            class="w-10 h-10 rounded-full bg-slate-900 border border-slate-800 flex items-center justify-center text-slate-300 hover:text-[#69a5bf] hover:border-[#69a5bf]/50 hover:bg-slate-800 transition-all"
          >
            <Mail class="w-4 h-4" />
          </a>
        </div>
      </div>

      <!-- Quick Navigation -->
      <div class="space-y-4">
        <h3 class="text-white text-base font-semibold tracking-wider uppercase text-xs">Quick Links</h3>
        <ul class="space-y-2.5 text-sm">
          {
            siteConfig.navLinks.map((link) => (
              <li>
                <a href={link.href} class="hover:text-[#69a5bf] transition-colors">
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Services List -->
      <div class="space-y-4">
        <h3 class="text-white text-base font-semibold tracking-wider uppercase text-xs">Our Services</h3>
        <ul class="space-y-2.5 text-sm">
          {
            servicesData.map((service) => (
              <li>
                <a href={`/services/${service.slug}`} class="hover:text-[#69a5bf] transition-colors line-clamp-1">
                  {service.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contact Info -->
      <div class="space-y-4">
        <h3 class="text-white text-base font-semibold tracking-wider uppercase text-xs">Contact Us</h3>
        <p class="text-sm text-slate-400">
          Have questions or need compliance support? Speak with our chartered experts today.
        </p>
        <a
          href={`mailto:${siteConfig.contactEmail}`}
          class="inline-flex items-center gap-2 text-sm text-[#69a5bf] font-medium hover:underline"
        >
          <Mail class="w-4 h-4" />
          <span>{siteConfig.contactEmail}</span>
        </a>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-slate-900 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>© Kulexar Consulting Ltd 2025. All rights reserved.</p>
      <a
        href="#top"
        aria-label="Back to top"
        class="inline-flex items-center gap-1.5 text-slate-400 hover:text-white transition-colors"
      >
        <span>Back to top</span>
        <ArrowUp class="w-4 h-4" />
      </a>
    </div>

  </div>
</footer>
