---
import Breadcrumbs from "./Breadcrumbs.astro";

interface Props {
  title: string;
  subtitle?: string;
  bgImage?: string;
  breadcrumbItems?: { label: string; href?: string }[];
}

const {
  title,
  subtitle,
  bgImage = "/img/services-banner.jpg",
  breadcrumbItems = []
} = Astro.props;
---

<div class="relative bg-slate-900 border-b border-slate-800 overflow-hidden py-16 sm:py-24">
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0 z-0">
    <img
      src={bgImage}
      alt={title}
      class="w-full h-full object-cover object-center opacity-30 scale-105 filter blur-[1px]"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/70 to-slate-900/60"></div>
  </div>

  <!-- Hero Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
    {breadcrumbItems.length > 0 && (
      <div class="flex justify-center mb-2">
        <Breadcrumbs items={breadcrumbItems} />
      </div>
    )}
    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight">
      <span class="gradient-text">{title}</span>
    </h1>
    {subtitle && (
      <p class="max-w-2xl mx-auto text-base sm:text-lg text-slate-300 font-normal leading-relaxed">
        {subtitle}
      </p>
    )}
  </div>
</div>
