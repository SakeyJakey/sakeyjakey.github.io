---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Pill from "../components/Pill.astro";
import { siteConfig } from "../data/site";
import { ShieldCheck, Target, Award, Users, CheckCircle2 } from "@lucide/astro";
---

<Layout title={`About Us | ${siteConfig.name}`} description="Learn about Kulexar Consulting, our Chartered professionals, and our mission to support your compliance and ESG strategy.">
  
  <Hero
    title="About Kulexar"
    subtitle="Chartered professionals delivering responsive, cost-effective, bespoke solutions."
    bgImage="/img/about-banner.jpg"
    breadcrumbItems={[{ label: "About" }]}
  />

  <div class="py-16 sm:py-24 bg-slate-950 space-y-20">
    
    <!-- Section 1: About Kulexar -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        
        <div class="space-y-6">
          <Pill>
            <Award class="w-4 h-4" />
            <span>Who We Are</span>
          </Pill>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
            Specialists in Compliance & Safety
          </h2>
          <p class="text-slate-300 text-base leading-relaxed">
            At Kulexar Consulting Ltd, we help organisations achieve and maintain the highest standards of compliance, safety, and operational excellence. Our expertise spans QSHE (Quality, Safety, Health & Environment), passive fire protection, fire risk assessment, compliance management, and sustainability, supporting businesses across a variety of sectors.
          </p>
          <p class="text-slate-300 text-base leading-relaxed">
            We work closely with clients to provide practical, independent assurance services that identify risks, strengthen compliance frameworks, and drive continuous improvement. From mock audits and subcontractor audit services to spot-check compliance visits, we deliver objective assessments and actionable recommendations that help organisations meet regulatory requirements and industry best practice.
          </p>
          <p class="text-slate-400 text-base leading-relaxed">
            Our approach is built on professionalism, integrity, and collaboration. We understand that every organisation faces unique challenges, which is why we tailor our services to provide clear, effective solutions that protect people, assets, and reputation while supporting long-term sustainable growth.
          </p>

          <div class="grid grid-cols-2 gap-4 pt-4 border-t border-slate-800">
            <div class="space-y-1">
              <span class="text-2xl font-bold text-white">Bespoke</span>
              <p class="text-xs text-slate-400">Tailored solutions for your organization</p>
            </div>
            <div class="space-y-1">
              <span class="text-2xl font-bold text-white">Chartered</span>
	      <p class="text-xs text-slate-400">Qualified, competent and insured assessors</p>
            </div>
          </div>
        </div>

        <div class="relative">
          <div class="rounded-3xl overflow-hidden border border-slate-800 shadow-2xl">
            <img
              src="/img/pfp-side1.jpeg"
              alt="Fire Safety and Compliance"
              class="w-full h-auto object-cover"
            />
          </div>
        </div>

      </div>
    </section>

    <!-- Section 2: What We Do -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 bg-slate-900/60 rounded-3xl border border-slate-800">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center p-6 sm:p-10">
        
        <div class="relative order-2 lg:order-1">
          <div class="rounded-2xl overflow-hidden border border-slate-700 shadow-2xl">
            <img
              src="/img/about-corridor.jpg"
              alt="Building Fire Safety & Compartmentation"
              class="w-full h-auto object-cover"
            />
          </div>
        </div>

        <div class="space-y-6 order-1 lg:order-2">
          <Pill>
            <Target class="w-4 h-4" />
            <span>Our Core Capabilities</span>
          </Pill>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
            What We Do
          </h2>

          <div class="space-y-5 text-sm">
            <div class="space-y-1.5">
              <h3 class="text-lg font-bold text-white flex items-center gap-2">
                <CheckCircle2 class="w-5 h-5 text-[#69a5bf]" />
                <span>Passive Fire Protection</span>
              </h3>
              <p class="text-slate-400 leading-relaxed pl-7">
                We provide expert surveys and advice relating to all elements of passive fire protection in construction, including fire doors, fire compartmentation, and passive fire stopping.
              </p>
            </div>

            <div class="space-y-1.5">
              <h3 class="text-lg font-bold text-white flex items-center gap-2">
                <CheckCircle2 class="w-5 h-5 text-[#69a5bf]" />
                <span>Sustainability</span>
              </h3>
              <p class="text-slate-400 leading-relaxed pl-7">
                We help you integrate sustainability into your operations and accelerate your decarbonization journey. Our services include strategic policy development, energy audits, and best-practice workshops.              </p>
            </div>

            <div class="space-y-1.5">
              <h3 class="text-lg font-bold text-white flex items-center gap-2">
                <CheckCircle2 class="w-5 h-5 text-[#69a5bf]" />
                <span>QSHE Compliance</span>
              </h3>
              <p class="text-slate-400 leading-relaxed pl-7">
                Our services support you in meeting all of your QSHE compliance requirements, including management systems (ISO 9001, ISO 14001, ISO 45001), mock audits, and site spot checks.
              </p>
            </div>
          </div>

        </div>

      </div>
    </section>

  </div>

</Layout>
