---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import GalleryCard from "../components/GalleryCard.astro";
import { galleryItems } from "../data/gallery";
import { siteConfig } from "../data/site";
---

<Layout title={`Gallery & Updates | ${siteConfig.name}`} description="Browse Kulexar's media feed, guides, video summaries, and industry posts on Passive Fire Protection and Sustainability.">
  
  <Hero
    title="Gallery & Knowledge Feed"
    subtitle="Stay informed with our technical guides, video summaries, and LinkedIn commentary on compliance best practices."
    bgImage="/img/gallery-banner.jpg"
    breadcrumbItems={[{ label: "Gallery" }]}
  />

  <section class="py-16 sm:py-24 bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Gallery Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          galleryItems.map((item) => (
            <GalleryCard item={item} />
          ))
        }
      </div>

    </div>
  </section>

</Layout>
