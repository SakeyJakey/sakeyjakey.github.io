      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="p-8 sm:p-12 rounded-2xl bg-slate-900 text-white relative overflow-hidden">

          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
            
            <div class="lg:col-span-7 space-y-6">
              <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[rgb(119,230,128)]/20 border border-[rgb(119,230,128)]/30 text-[rgb(119,230,128)] text-xs font-bold uppercase tracking-wider">
                <RefreshCw class="w-3.5 h-3.5" />
                <span>Hardware Circularity in Action</span>
              </div>

              <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
                The ThinkPad Revival Project
