    <!-- Image Lightbox Modal -->
    <div id="image-modal" class="fixed inset-0 z-[100] hidden items-center justify-center p-4 sm:p-6 bg-slate-950/90 backdrop-blur-md transition-opacity duration-300 opacity-0" aria-modal="true" role="dialog">
      <button id="close-modal" type="button" class="absolute top-5 right-5 p-3 rounded-full bg-white/10 hover:bg-white/20 text-white transition-colors cursor-pointer" aria-label="Close image preview">
        <X class="w-6 h-6" />
      </button>
      <div class="max-w-5xl max-h-[90vh] flex flex-col items-center gap-3">
        <img id="modal-img" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E" alt="Expanded event preview" class="max-h-[78vh] max-w-full object-contain rounded-2xl shadow-2xl border border-white/15" />
        <p id="modal-caption" class="text-xs sm:text-sm text-slate-200 text-center font-medium px-4"></p>
      </div>
    </div>

    <script>
      const modal = document.getElementById('image-modal');
      const modalImg = document.getElementById('modal-img') as HTMLImageElement;
      const modalCaption = document.getElementById('modal-caption');
      const closeBtn = document.getElementById('close-modal');
      const triggers = document.querySelectorAll('.post-image-trigger');

      function openModal(imgSrc: string, caption: string) {
        if (!modal || !modalImg) return;
        modalImg.src = imgSrc;
        if (modalCaption) modalCaption.textContent = caption || '';
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        requestAnimationFrame(() => {
          modal.classList.remove('opacity-0');
        });
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        if (!modal) return;
        modal.classList.add('opacity-0');
        setTimeout(() => {
          modal.classList.remove('flex');
          modal.classList.add('hidden');
          if (modalImg) modalImg.src = '';
          document.body.style.overflow = '';
        }, 250);
      }

      triggers.forEach(trigger => {
        trigger.addEventListener('click', () => {
          const src = trigger.getAttribute('data-img') || '';
          const cap = trigger.getAttribute('data-caption') || '';
          if (src) openModal(src, cap);
        });
      });

      closeBtn?.addEventListener('click', closeModal);
      modal?.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
          closeModal();
        }
      });
    </script>

