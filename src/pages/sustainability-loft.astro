                  <div class="text-xs text-slate-400 font-medium">1. Rescue</div>
                  <div class="text-sm font-bold text-white mt-1">Old ThinkPads Collected</div>
                </div>
                <div class="p-4 rounded-2xl bg-slate-800/80 border border-slate-700/80">
                  <div class="text-xs text-slate-400 font-medium">2. Refurbish</div>
                  <div class="text-sm font-bold text-[rgb(74,168,218)] mt-1">Repaired & Upgraded</div>
                </div>
