                  class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[rgb(119,230,128)] text-slate-950 font-bold text-sm hover:bg-[rgb(100,215,110)] transition-colors"
                >
                  <span>Request a Laptop or Donate Hardware</span>
                  <ArrowRight class="w-4 h-4" />
                </a>
              </div>
            </div>

            <div class="lg:col-span-5 flex justify-center">
              <div class="p-6 rounded-2xl bg-slate-800 border border-slate-700 w-full space-y-4 text-center">
                <Laptop class="w-16 h-16 text-[rgb(74,168,218)] mx-auto" />
                <h3 class="text-xl font-bold text-white">Have Old Tech to Donate?</h3>
                <p class="text-slate-300 text-xs leading-relaxed">
                  We accept old Lenovo ThinkPads (X, T, L, or P series), power adapters, and spare components. We erase all data securely before refurbishment.
                </p>
                <div class="pt-2">
                  <span class="text-xs text-[rgb(119,230,128)] font-semibold">✔ Fully Secure Data Wiping Provided</span>
