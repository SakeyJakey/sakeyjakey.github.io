---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import ContactForm from "../components/ContactForm.astro";
import Pill from "../components/Pill.astro";
import SocialIcons from "../components/icons/SocialIcons.astro";
import { siteConfig } from "../data/site";
import { Mail, Clock, ShieldCheck, MapPin } from "@lucide/astro";
---

<Layout title={`Contact Us | ${siteConfig.name}`} description="Get in touch with Kulexar Consulting for compliance, fire safety, QSHE, and sustainability inquiries.">
  
  <Hero
    title="Contact Kulexar"
    subtitle="Speak directly with our Chartered experts to discuss your fire safety, compliance, and sustainability requirements."
    bgImage="/img/contact-banner.jpg"
    breadcrumbItems={[{ label: "Contact" }]}
  />

  <section class="py-16 sm:py-24 bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Contact Info Cards Column -->
        <div class="lg:col-span-5 space-y-6">
          
          <div class="space-y-3">
            <Pill>
              <span>Get in Touch</span>
            </Pill>
            <h2 class="text-3xl font-extrabold text-white tracking-tight">
              We're Here to Help
            </h2>
            <p class="text-slate-400 text-sm leading-relaxed">
              Whether you require a fire risk assessment, or QSHE compliance management audit, our team responds promptly to all enquiries.
            </p>
          </div>

          <!-- Email Card -->
          <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800 flex items-start gap-4 hover:border-[#69a5bf]/40 transition-colors">
            <div class="p-3 rounded-xl bg-[#69a5bf]/10 text-[#69a5bf] shrink-0">
              <Mail class="w-6 h-6" />
            </div>
            <div class="space-y-1">
              <h3 class="text-base font-bold text-white">Direct Email</h3>
              <p class="text-slate-400 text-xs">For general inquiries, quotes & booking</p>
              <a href={`mailto:${siteConfig.contactEmail}`} class="text-sm font-semibold text-[#69a5bf] hover:underline block pt-1">
                {siteConfig.contactEmail}
              </a>
            </div>
          </div>

          <!-- Social Connect Card -->
          <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800 space-y-4">
            <h3 class="text-base font-bold text-white">Connect On Social Media</h3>
            <div class="flex items-center gap-3">
              <a
                href={siteConfig.socials.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="flex-1 p-3 rounded-xl bg-slate-950 border border-slate-800 hover:border-[#69a5bf]/50 flex items-center justify-center gap-2 text-xs font-semibold text-slate-300 hover:text-white transition-colors"
              >
                <SocialIcons name="linkedin" class="w-4 h-4 text-[#69a5bf]" />
                <span>LinkedIn</span>
              </a>
              <a
                href={siteConfig.socials.instagram}
                target="_blank"
                rel="noopener noreferrer"
                class="flex-1 p-3 rounded-xl bg-slate-950 border border-slate-800 hover:border-[#69a5bf]/50 flex items-center justify-center gap-2 text-xs font-semibold text-slate-300 hover:text-white transition-colors"
              >
                <SocialIcons name="instagram" class="w-4 h-4 text-[#69a5bf]" />
                <span>Instagram</span>
              </a>
            </div>
          </div>

        </div>

        <!-- Form Column -->
        <div class="lg:col-span-7">
          <ContactForm />
        </div>

      </div>

    </div>
  </section>

</Layout>
